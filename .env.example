# ==============================================================================
# KYVORA - ARCHIVO DE CONFIGURACIÓN DE EJEMPLO (.env.example)
# ==============================================================================
# ADVERTENCIA: NUNCA coloques credenciales ni secretos reales en este archivo
# ni en el repositorio de Git. Copia este archivo a `.env.local` y configura
# tus claves reales de forma segura en tu entorno local y en el panel de Vercel.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. URL DEL SITIO (Canonical y Redirecciones)
# ------------------------------------------------------------------------------
# En desarrollo local: http://localhost:3000
# En producción: https://www.kyvora.net.co
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. WOMPI COLOMBIA (Pasarela de Pagos & Aportes Voluntarios)
# ------------------------------------------------------------------------------
# Entorno: 'sandbox' o 'production'
NEXT_PUBLIC_WOMPI_ENVIRONMENT=sandbox

# Llave Pública de Wompi (empieza por 'pub_test_' en Sandbox o 'pub_prod_' en Prod)
# Esta clave se expone al cliente para inicializar el checkout alojado.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_examplePublicKey1234567890

# Secreto de Integridad de Wompi (PRIVADO - NUNCA expongas con NEXT_PUBLIC_)
# Utilizado exclusivamente por el servidor para calcular el hash SHA-256 de integridad.
WOMPI_INTEGRITY_SECRET=test_integrity_exampleSecretHash1234567890

# Secreto de Eventos / Webhooks de Wompi (PRIVADO - NUNCA expongas con NEXT_PUBLIC_)
# Utilizado por el endpoint `/api/webhooks/wompi` para validar la autenticidad del checksum.
WOMPI_EVENTS_SECRET=test_events_exampleChecksumSecret1234567890

# Llave Privada de Wompi (PRIVADO - NUNCA expongas con NEXT_PUBLIC_)
# Utilizada en el servidor para consultar transacciones directamente a la API oficial de Wompi (/v1/transactions/:id).
# Empieza por 'prv_test_' en Sandbox o 'prv_prod_' en Producción.
WOMPI_PRIVATE_KEY=prv_test_examplePrivateKey1234567890

# ------------------------------------------------------------------------------
# 3. BASE DE DATOS POSTGRESQL (Requerido para Producción en Vercel)
# ------------------------------------------------------------------------------
# Cadena de conexión a base de datos PostgreSQL persistente (Neon, Supabase o Vercel Postgres).
# Si no está definida, el servidor utilizará el almacén local 'data/transactions.json' para desarrollo.
DATABASE_URL=postgres://usuario:contrasena@host:5432/nombre_bd?sslmode=require

# ------------------------------------------------------------------------------
# 4. ENVÍO DE CORREOS / FORMULARIO DE CONTACTO (Resend)
# ------------------------------------------------------------------------------
# API Key de Resend (PRIVADO)
# Si no está configurada, el formulario de contacto registrará los envíos en modo simulación (consola).
RESEND_API_KEY=re_exampleApiKey1234567890

# Correo de destino donde el propietario recibirá los mensajes de contacto
CONTACT_NOTIFICATION_EMAIL=kyvorasas@gmail.com

